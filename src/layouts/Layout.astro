---
import '@/styles/global.css'
import '@/styles/typography.css'

import Head from '@/components/Head.astro'
import { SITE } from '@/consts'
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="bg-background text-foreground flex min-h-screen font-sans">
    <main class="mx-auto flex w-full max-w-3xl flex-1 items-center px-4">
      <section class="w-full rounded-lg border p-8 text-center">
        <h1 class="text-3xl font-semibold">Under Maintenance</h1>
        <p class="text-muted-foreground mt-3 text-base">
          This site is currently undergoing maintenance. Please check back soon.
        </p>
      </section>
    </main>
  </body>
</html>
